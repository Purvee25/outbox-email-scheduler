# Copy to backend/.env and fill in. Never commit real values.

NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

DATABASE_URL=mysql://scheduler:scheduler@localhost:3307/scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# 32+ random chars: openssl rand -hex 32
SESSION_SECRET=
# 32 bytes hex, used for AES-256-GCM of Slack webhook URLs: openssl rand -hex 32
ENCRYPTION_KEY=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: ${API_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# api.slack.com/apps → OAuth & Permissions, scope: incoming-webhook
# Redirect URL: ${API_PUBLIC_URL}/api/slack/callback (Slack requires HTTPS — use ngrok locally)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# "ethereal" (real SMTP to Ethereal) or "log" (no network; for local runs and load tests)
MAIL_TRANSPORT=ethereal

# Comma-separated Ethereal accounts (https://ethereal.email/create): user:pass,user:pass
ETHEREAL_SENDERS=

# Comma-separated emails allowed to view Bull Board at /admin/queues
ADMIN_EMAILS=

# Throughput
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_SEND_ATTEMPTS=3
