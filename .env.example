# Copy to backend/.env for local dev.
# For production: copy to .env.production at the repo root (used by docker-compose.prod.yml).
# Never commit real values.

NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Production: https://your-app.duckdns.org
API_PUBLIC_URL=http://localhost:4000

# Local dev (docker-compose.yml exposes MySQL on 3307)
DATABASE_URL=mysql://scheduler:scheduler@localhost:3307/scheduler
# Production compose uses the internal Docker hostname:
# DATABASE_URL is constructed from MYSQL_* vars in docker-compose.prod.yml
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Secrets (generate both with: openssl rand -hex 32) ---
SESSION_SECRET=
ENCRYPTION_KEY=

# --- MySQL (only needed by docker-compose.prod.yml) ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# --- Google OAuth ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorised redirect URI: ${API_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Slack ---
# api.slack.com/apps → OAuth & Permissions, scope: incoming-webhook
# Redirect URL: ${API_PUBLIC_URL}/api/slack/callback  (Slack requires HTTPS — use ngrok locally)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Mail ---
# "ethereal" sends real SMTP and generates preview URLs; "log" skips the network (load tests)
MAIL_TRANSPORT=ethereal
# Create accounts at https://ethereal.email/create — format: user:pass,user:pass
ETHEREAL_SENDERS=

# --- Admin ---
# Comma-separated emails allowed to view Bull Board at /admin/queues
ADMIN_EMAILS=

# --- Throughput ---
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_SEND_ATTEMPTS=3
