# Copy to frontend/.env.local. Public: inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Optional: run everything through one HTTPS tunnel (needed for Slack OAuth locally) ---
# Copy these into .env.local, leave NEXT_PUBLIC_API_URL EMPTY, and see README "Slack over a tunnel".
# NEXT_PUBLIC_API_URL=
# API_PROXY_TARGET=http://localhost:4000
# DEV_TUNNEL_HOST=your-name.ngrok-free.app
