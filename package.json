{
  "name": "outbox-email-scheduler",
  "private": true,
  "workspaces": [
    "packages/shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev:api -w backend",
    "dev:worker": "npm run dev:worker -w backend",
